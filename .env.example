# ==============================================================================
# AegisTrial Clinical Trial Recruitment System - Environment Variables
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Database Connection (Default: local SQLite; for Production use PostgreSQL)
# PostgreSQL Example: postgresql://postgres:password@localhost:5432/clinical_trial
DATABASE_URL=sqlite:///./clinical_trial.db

# Hyperledger Fabric Network Configuration
FABRIC_ENABLE_REAL_NETWORK=false
FABRIC_CHANNEL=clinical-trials
FABRIC_CHAINCODE=patient-recruitment-contract
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051

# Frontend API Base URL (leave empty when running via Vite proxy)
VITE_API_URL=http://localhost:8000
